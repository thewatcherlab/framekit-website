# build output
dist/
# generated types
.astro/
# Cloudflare runtime types, made by `pnpm cf-typegen` (they also copy the vars in wrangler.jsonc)
worker-configuration.d.ts

# dependencies
node_modules/
# this project installs with pnpm (pnpm-lock.yaml); other lockfiles go stale
package-lock.json
yarn.lock
bun.lock*

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables and secrets: keep only the examples
.env
.env.*
!.env.example
.dev.vars*
!.dev.vars.example
*.pem
*.key

# Cloudflare Wrangler's local state and cache
.wrangler/

# app builds and archives that end up next to the site
*.zip
*.dmg
*.app/
*.xcarchive/

# editors and OS files
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# local agent settings
.claude/settings.local.json
