---
import MarketingLayout from "../layouts/marketing-layout.astro";
import BugReportForm from "../components/marketing/bug-report-form.astro";
---

<MarketingLayout title="Report a bug — FrameKit" description="Tell us what went wrong in FrameKit.">
	<article class="prose-page">
		<h1>Report a bug</h1>
		<p class="muted">Describe the steps and the result. Attach a screenshot or short recording if you have one.</p>
		<BugReportForm />
	</article>
</MarketingLayout>
