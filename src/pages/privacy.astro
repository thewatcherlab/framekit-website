---
import MarketingLayout from "../layouts/marketing-layout.astro";
import { frame } from "../config/frame";
---

<MarketingLayout title="Privacy — FrameKit" description="FrameKit does not collect personal data.">
	<article class="prose-page">
		<h1>Privacy</h1>
		<p>FrameKit doesn’t collect any data or personal information, and it has no analytics.</p>
		<p>
			Your screenshots and recordings stay on your Mac, in the folder you choose. The only time FrameKit sends
			anything over the network is when you upload a capture to your own Cloudflare R2 or S3-compatible bucket.
			Those credentials stay in your Keychain.
		</p>
		<p>Captions in Recorder Studio are made on your Mac with Apple’s on-device speech recognition.</p>
		<p class="muted">
			Questions go to <a href={`mailto:${frame.email}`}>{frame.email}</a>.
		</p>
	</article>
</MarketingLayout>
