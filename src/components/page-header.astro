---
import Container from "./container.astro";

interface Props {
	title: string;
	lede?: string;
}

const { title, lede } = Astro.props;
---

<Container class="pt-loose text-center md:pt-section">
	<h1 class="mx-auto max-w-[18ch] text-heading text-charcoal-body">{title}</h1>
	{
		lede && (
			<p class="mx-auto mt-nav max-w-xl text-body text-pretty text-slate-caption">{lede}</p>
		)
	}
</Container>
