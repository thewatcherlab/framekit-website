---
import type { FeatureIcon } from "../config/site";

interface Props {
	name: FeatureIcon | "check";
	class?: string;
}

const { name, class: className = "size-5" } = Astro.props;
---

<svg
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.5"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	class={className}
>
	{
		name === "inbox" && (
			<>
				<path d="M4 13h4.2a2 2 0 0 0 1.8 1.2h4a2 2 0 0 0 1.8-1.2H20" />
				<path d="M4 13 6.2 6.8A2 2 0 0 1 8.1 5.5h7.8a2 2 0 0 1 1.9 1.3L20 13v4.2a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Z" />
			</>
		)
	}
	{
		name === "release" && (
			<>
				<path d="M12 4v11" />
				<path d="m7.5 11 4.5 4.5L16.5 11" />
				<path d="M5 20h14" />
			</>
		)
	}
	{
		name === "status" && (
			<>
				<circle cx="12" cy="12" r="7.25" />
				<path d="M12 8.5V12l2.25 2" />
			</>
		)
	}
	{name === "check" && <path d="m5 12.5 4.2 4.2L19 7.5" />}
</svg>
