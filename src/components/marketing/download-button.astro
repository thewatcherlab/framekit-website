---
interface Props {
	href: string;
	label?: string;
	tone?: "solid" | "soft" | "gumroad";
	/** The mark on the left: Apple for the direct download, Gumroad for the store page. */
	icon?: "apple" | "gumroad";
}

const { href, label = "Download for Mac", tone = "solid", icon = "apple" } = Astro.props;
const external = /^https?:/.test(href);
---

<a
	class:list={["dl", tone]}
	href={href}
	aria-label={label}
	target={external ? "_blank" : undefined}
	rel={external ? "noopener" : undefined}
>
	<span class="dl-icon" aria-hidden="true">
		<svg viewBox="0 0 24 24" width="25" height="25">
			{icon === "gumroad" ? (
				<path
					fill="currentColor"
					d="M12 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0Zm-.007 5.12c4.48 0 5.995 3.025 6.064 4.744h-3.239c-.069-.962-.897-2.406-2.896-2.406-2.136 0-3.514 1.857-3.514 4.126 0 2.27 1.378 4.125 3.514 4.125 1.93 0 2.758-1.512 3.103-3.025h-3.103v-1.238h6.509v6.327h-2.855v-3.989c-.207 1.444-1.102 4.264-4.617 4.264-3.516 0-5.584-2.82-5.584-6.326 0-3.645 2.276-6.602 6.618-6.602z"
				></path>
			) : (
			<path
				fill="currentColor"
				d="M19.37 7.648c-.114.088-2.11 1.213-2.11 3.715 0 2.894 2.54 3.918 2.616 3.944-.011.062-.403 1.402-1.34 2.767-.834 1.201-1.706 2.4-3.032 2.4s-1.667-.77-3.198-.77c-1.492 0-2.022.796-3.235.796-1.214 0-2.06-1.112-3.033-2.477C4.911 16.42 4 13.93 4 11.566c0-3.791 2.465-5.802 4.891-5.802 1.29 0 2.364.847 3.173.847.77 0 1.972-.897 3.438-.897.556 0 2.553.05 3.867 1.934Zm-4.564-3.54c.607-.719 1.036-1.718 1.036-2.716 0-.138-.012-.279-.037-.392-.987.037-2.161.657-2.87 1.478-.555.632-1.074 1.63-1.074 2.643 0 .152.026.304.037.353.063.011.164.025.266.025.885 0 1.998-.593 2.642-1.39Z"
			></path>
			)}
		</svg>
	</span>
	<span class="dl-label">{label}</span>
	<span class="dl-arrow" aria-hidden="true">
		<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M4.5 12h13.25M12.75 5.25 19.5 12l-6.75 6.75"></path>
		</svg>
	</span>
</a>
