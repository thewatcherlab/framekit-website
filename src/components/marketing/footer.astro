---
import { frame } from "../../config/frame";
---

<footer class="site-footer">
	<div class="socials">
		<a class="icon-btn" href={frame.repo} target="_blank" rel="noopener noreferrer" aria-label="FrameKit on GitHub">
			<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
				<path
					d="M12 1.5a10.5 10.5 0 0 0-3.32 20.46c.53.1.72-.23.72-.5v-1.85c-2.92.63-3.54-1.25-3.54-1.25-.48-1.22-1.17-1.54-1.17-1.54-.95-.65.08-.64.08-.64 1.05.08 1.6 1.08 1.6 1.08.94 1.6 2.46 1.14 3.06.87.1-.68.37-1.14.66-1.4-2.33-.27-4.78-1.17-4.78-5.18 0-1.14.41-2.08 1.08-2.81-.11-.27-.47-1.33.1-2.77 0 0 .88-.28 2.89 1.07a10 10 0 0 1 5.25 0c2-1.35 2.88-1.07 2.88-1.07.58 1.44.22 2.5.11 2.77.67.73 1.08 1.67 1.08 2.81 0 4.02-2.46 4.9-4.8 5.16.38.33.71.97.71 1.96v2.9c0 .28.19.61.73.5A10.5 10.5 0 0 0 12 1.5Z"
				></path>
			</svg>
		</a>
		<a class="icon-btn" href={`mailto:${frame.email}`} aria-label="Email">
			<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
				<path
					d="M4.5 4.5h15A2.5 2.5 0 0 1 22 7v10a2.5 2.5 0 0 1-2.5 2.5h-15A2.5 2.5 0 0 1 2 17V7a2.5 2.5 0 0 1 2.5-2.5Zm.2 2 6.62 5.3a1.1 1.1 0 0 0 1.36 0l6.62-5.3H4.7Zm15.3 1.43-6.38 5.1a2.6 2.6 0 0 1-3.24 0L4 7.93V17c0 .28.22.5.5.5h15a.5.5 0 0 0 .5-.5V7.93Z"
				></path>
			</svg>
		</a>
	</div>
	<nav class="footer-links" aria-label="More">
		<a href="/faqs">FAQs</a>
		<a href="/changelog">Changelog</a>
		<a href="/report">Report a bug</a>
		<a href="/privacy">Privacy</a>
		<a href="/terms">Terms</a>
	</nav>
	<div class="wordmark" aria-hidden="true">{frame.name}</div>
</footer>

<style>
	.footer-links {
		display: flex;
		gap: 1.25rem;
		margin-top: 1.5rem;
		color: rgb(67 20 7 / 0.5);
		font-size: 0.875rem;
		font-weight: 700;
	}

	.footer-links a:hover {
		color: rgb(67 20 7 / 0.8);
	}

	.footer-links a:focus-visible {
		outline: 3px solid rgb(167 139 250 / 0.9);
		outline-offset: 3px;
		border-radius: 0.25rem;
	}
</style>
